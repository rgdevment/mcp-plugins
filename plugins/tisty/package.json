    "documents",
    "markdown",
    "local-first",
    "todo",
    "task-manager",
    "mcp-server",
    "claude",
    "claude-code",
    "github-copilot",
    "cursor",
    "codex"
  ],
  "homepage": "https://www.tisty.app/docs/assistants-and-mcp/",
